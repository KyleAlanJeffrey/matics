{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Matics",
  "version": "0.2.0",
  "identifier": "ai.stout.diagram-maker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5199",
    "beforeDevCommand": "pnpm dev --port 5199 --strictPort --host 127.0.0.1",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Matics",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 25 }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "/Volumes/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["matics"],
        "name": "Compressed Matics Project",
        "description": "Compressed Matics project",
        "role": "Editor",
        "mimeType": "application/x-matics",
        "contentTypes": ["ai.stout.matics.compressed"],
        "exportedType": { "identifier": "ai.stout.matics.compressed", "conformsTo": ["public.data"] }
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3NUVFQ0RERDYzNDgzQjAKUldTd2d6VFczZXhlNXpnNFN3K05Rall0Sk9TYTFRV3h6eDBpQTgzSGNRVUtSN3UvMlg4dXNXOTEK",
      "endpoints": ["https://github.com/KyleAlanJeffrey/matics/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
